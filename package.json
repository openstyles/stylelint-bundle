{
  "name": "stylelint-bundle",
  "version": "17.13.0",
  "description": "Create & provide a bundled version of Stylelint",
  "dependencies": {
    "stylelint": "17.13.0",
    "postcss-less": "6.0.0",
    "sugarss": "^5.0.1"
  },
  "keywords": [
    "css",
    "less",
    "scss",
    "sugarss",
    "lint",
    "linter",
    "stylelint",
    "bundle",
    "browserify"
  ],
  "authors": [
    "Rob Garrison",
    "eight04",
    "tophf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstyles/stylelint-bundle.git"
  },
  "main": "dist/stylelint-bundle.min.js",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "chalk": "^5.6.2",
    "css-functions-list": "^3.3.3",
    "css-tree": "^3.2.1",
    "mocha": "^12.0.0-beta-9.6",
    "rollup": "^4.61.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-es-info": "^0.3.0",
    "rollup-plugin-iife": "^0.8.0",
    "rollup-plugin-re": "^1.0.7",
    "rollup-plugin-visualizer": "^5.14.0"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "update": "npm install stylelint@latest --save-exact && node tools/update.js",
    "build": "rollup -c",
    "test": "mocha"
  },
  "overrides": {
    "rollup-plugin-es-info": {
      "rollup": "^4.0.0"
    }
  }
}
